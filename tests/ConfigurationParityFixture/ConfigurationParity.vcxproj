<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="imported.props" />
  <ItemGroup>
    <ClCompile Include="Actor.cpp">
      <AdditionalIncludeDirectories Condition="'$(Configuration)'=='Debug'">$(SharedRoot)/debug</AdditionalIncludeDirectories>
      <AdditionalIncludeDirectories Condition="'$(Configuration)'=='Release'">$(SharedRoot)/release</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">DEBUG=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ForcedIncludeFiles Condition="'$(Platform)'=='Win32'">win32.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
    <ClCompile Include="ACTOR.cpp"><PreprocessorDefinitions>DUPLICATE=1</PreprocessorDefinitions></ClCompile>
    <ClInclude Include="Shared.h"><PreprocessorDefinitions>HEADER=1</PreprocessorDefinitions></ClInclude>
  </ItemGroup>
</Project>
